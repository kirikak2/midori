# Board configuration generated by CMake
# DO NOT EDIT - this file is auto-generated from board_config.rb.in

module BoardConfig
  # Board name
  BOARD_NAME = "@BOARD_NAME@"

  # SD Card interface mode: "sdmmc" or "spi"
  SD_MODE = "@SD_MODE@"

  # SDMMC pins (for Freenove / CrowPanel)
  SD_CLK_PIN = @SD_CLK_PIN@
  SD_CMD_PIN = @SD_CMD_PIN@
  SD_D0_PIN  = @SD_D0_PIN@

  # SDMMC host slot the card slot is wired to (-1 = let the driver pick).
  # Not implied by the pins: on the ESP32-P4 slot 0 has dedicated IOMUX pins
  # that the GPIO matrix cannot reach, so a card on those pins is only
  # reachable through slot 0.
  SD_SLOT = @SD_SLOT@

  # SDMMC bus clock ceiling in kHz (-1 = driver default, 20MHz)
  SD_FREQ_KHZ = @SD_FREQ_KHZ@

  # SPI pins (for M5Stack)
  SD_SCK_PIN  = @SD_SCK_PIN@
  SD_MISO_PIN = @SD_MISO_PIN@
  SD_MOSI_PIN = @SD_MOSI_PIN@
  SD_CS_PIN   = @SD_CS_PIN@

  # SPI unit for SD card (SPI mode only)
  SD_SPI_UNIT = :ESP32_SPI2_HOST

  # MIDI Device Configuration
  # SAM2695 synthesizer pins
  SAM2695_TX_PIN = @SAM2695_TX_PIN@
  SAM2695_RX_PIN = @SAM2695_RX_PIN@
  HAS_SAM2695 = @HAS_SAM2695@

  # USB-MIDI Host support
  HAS_USB_MIDI_HOST = @HAS_USB_MIDI_HOST@

  # USB-MIDI Device support (for future implementation)
  HAS_USB_MIDI_DEVICE = @HAS_USB_MIDI_DEVICE@

  # AMY software synthesizer on the board's speaker (picoruby-amy)
  HAS_AMY = @HAS_AMY@

  # Primary I2C bus for accessories (e.g. DFRobot rotary encoders).
  # PRIMARY_I2C_UNIT names the underlying hardware bus, which varies by board.
  # A board without a dedicated I2C connector puts this on the SAM2695 UART
  # pins (Port A on Tab5), so there HAS_PRIMARY_I2C and HAS_SAM2695 are
  # mutually exclusive at runtime, not at build time -- pick one use per
  # script. CrowPanel has its own I2C connector (a tap on the touch
  # controller's bus, hence I2C1) and can drive both at once.
  HAS_PRIMARY_I2C      = @HAS_PRIMARY_I2C@
  PRIMARY_I2C_SDA_PIN  = @PRIMARY_I2C_SDA_PIN@
  PRIMARY_I2C_SCL_PIN  = @PRIMARY_I2C_SCL_PIN@
  PRIMARY_I2C_UNIT     = "@PRIMARY_I2C_UNIT@"
end
